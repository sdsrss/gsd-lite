{
  "name": "gsd-lite",
  "version": "0.14.0",
  "description": "AI orchestration tool for Claude Code — GSD management shell + Superpowers quality core",
  "type": "module",
  "bin": {
    "gsd": "./cli.js"
  },
  "scripts": {
    "test": "node --require ./tests/git-sandbox.cjs --test tests/*.test.js",
    "test:coverage": "node --require ./tests/git-sandbox.cjs --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=80 --test-coverage-branches=75 tests/*.test.js",
    "lint": "biome check src/ tests/ hooks/ cli.js install.js uninstall.js launcher.js scripts/",
    "lint:fix": "biome check --write src/ tests/ hooks/ cli.js install.js uninstall.js launcher.js scripts/",
    "start": "node src/server.js",
    "version": "node scripts/sync-versions.js && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json",
    "prepare": "[ -d .git ] && ln -sf ../../scripts/pre-commit.sh .git/hooks/pre-commit || true",
    "prepublishOnly": "node scripts/sync-versions.js && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sdsrss/gsd-lite"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "orchestration",
    "ai-agent",
    "task-management"
  ],
  "files": [
    ".claude-plugin/",
    "src/",
    "commands/",
    "agents/",
    "workflows/",
    "references/",
    "hooks/",
    "cli.js",
    "launcher.js",
    "install.js",
    "uninstall.js"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "overrides": {
    "hono": "^4.13.8",
    "@hono/node-server": "^1.19.14",
    "ip-address": "^10.7.2",
    "fast-uri": "^4.2.1",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6"
  }
}
