#!/usr/bin/env node
// A stand-in for the `claude` CLI, first on PATH for the whole test suite
// (tests/git-sandbox.cjs puts this directory there), so no test can reach a
// developer's real CLI and the real ~/.claude.json behind it.
//
// It does what the real `claude mcp add -s user` / `claude mcp remove -s user`
// do to the user config, with the same exit codes and messages (measured on
// Claude Code 2.1.308): add writes `{type:'stdio',command,args,env:{}}` under
// the top-level mcpServers of the user config and exits 1 with "already
// exists" if the name is taken; remove exits 1 when the name is absent. The
// user config is the file the real CLI picks: <config dir>/.config.json when
// that is non-empty (or empty, writable and alone), the directory's name
// normalized to NFC; else ${CLAUDE_CONFIG_DIR || HOME}/.claude.json, named
// .claude-custom-oauth.json while CLAUDE_CODE_CUSTOM_OAUTH_URL is set. An
// existing file it cannot read, or that is empty or not JSON, is left alone,
// with exit 1: a stand-in must never rewrite a config (the real CLI resets
// one it cannot parse, and overwrites one it cannot read).
// tests/mcp-registration.test.js holds this against the real CLI when one is
// installed.
//
// Every call is appended to fake-claude-calls.jsonl beside that file.
// GSD_FAKE_CLAUDE_FAIL=<subcommand> makes that subcommand fail;
// GSD_FAKE_CLAUDE_FAIL=add:exists makes add answer "already exists", as the
// real CLI does for a registration in a config file the caller did not read.
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const argv = process.argv.slice(2);
const dir = process.env.CLAUDE_CONFIG_DIR || os.homedir();
const modern = path.join(dir, `.claude${process.env.CLAUDE_CODE_CUSTOM_OAUTH_URL ? '-custom-oauth' : ''}.json`);
const legacy = path.join((process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude')).normalize('NFC'), '.config.json');
let configPath = modern;
try {
  const stat = fs.statSync(legacy);
  if (stat.isFile() && (stat.size > 0 || ((stat.mode & 0o222) !== 0 && !fs.existsSync(modern)))) configPath = legacy;
} catch { /* no legacy file */ }

// Only ever a temp config: a fixture that forgot its CLAUDE_CONFIG_DIR or
// HOME gets an error, not a write into the real ~/.claude.json.
const real = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
if (!`${real(dir)}${path.sep}`.startsWith(`${real(os.tmpdir())}${path.sep}`)) {
  process.stderr.write(`fake claude: refusing a config outside ${os.tmpdir()}: ${dir}\n`);
  process.exit(2);
}
try {
  fs.appendFileSync(path.join(dir, 'fake-claude-calls.jsonl'), `${JSON.stringify({ argv })}\n`);
} catch { /* no such directory: the call still answers */ }

function fail(message, code = 1) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function readConfig() {
  let text;
  try {
    text = fs.readFileSync(configPath, 'utf8');
  } catch (err) {
    if (err.code === 'ENOENT') return {};
    return fail(`fake claude: ${configPath} cannot be read (${err.code}); left as it is`);
  }
  try { return JSON.parse(text); } catch { return fail(`fake claude: ${configPath} is not JSON; left as it is`); }
}

function writeConfig(config) {
  fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(configPath, `${JSON.stringify(config, null, 2)}\n`);
}

const [group, sub, ...rest] = argv;
if (group !== 'mcp' || !['add', 'remove'].includes(sub)) fail(`fake claude: unsupported command: ${argv.join(' ')}`, 2);
let scope = 'local';
const positional = [];
let tail = null;
for (let i = 0; i < rest.length; i++) {
  if (rest[i] === '--') { tail = rest.slice(i + 1); break; }
  if (rest[i] === '-s' || rest[i] === '--scope') { scope = rest[++i]; continue; }
  positional.push(rest[i]);
}
if (scope !== 'user') fail(`fake claude: only user scope is modelled, got ${scope}`, 2);
const [name, ...more] = positional;
if (process.env.GSD_FAKE_CLAUDE_FAIL === sub) fail(`fake claude: ${sub} failed on purpose`);
if (process.env.GSD_FAKE_CLAUDE_FAIL === `${sub}:exists`) fail(`MCP server ${name} already exists in user config`);
const config = readConfig();

if (sub === 'add') {
  const [command, ...args] = tail ?? more;
  if (!name || !command) fail('fake claude: mcp add needs a name and a command', 2);
  if (config.mcpServers?.[name]) fail(`MCP server ${name} already exists in user config`);
  config.mcpServers = { ...config.mcpServers, [name]: { type: 'stdio', command, args, env: {} } };
  writeConfig(config);
  process.stdout.write(`Added stdio MCP server ${name} with command: ${[command, ...args].join(' ')} to user config\n`);
} else {
  if (!config.mcpServers?.[name]) fail(`No MCP server named "${name}" in user scope`);
  delete config.mcpServers[name];
  writeConfig(config);
  process.stdout.write(`Removed MCP server ${name} from user config\n`);
}
